{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tuneprint",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "tuneprint.dracars.com",
      "custom_domain": true
    }
  ]
}
